   handleFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.src = e.target.result;
        img.onload = () => {
          // Redimensionăm imaginea la maximum 1000px lățime/înălțime pentru a economisi spațiu masiv în memorie
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          const maxDimension = 1000;

          if (width > height && width > maxDimension) {
            height = Math.round((height * maxDimension) / width);
            width = maxDimension;
          } else if (height > maxDimension) {
            width = Math.round((width * maxDimension) / height);
            height = maxDimension;
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          // Convertim în JPEG comprimat (calitate 0.8) în loc de PNG sau Base64 brut imens
          this.imageUrlInput = canvas.toDataURL('image/jpeg', 0.8);
        };
      };
      reader.readAsDataURL(file);
    },

  insertImageToElement() {
          if (!this.imageUrlInput || this.activeElementIndexForImage === null) return;
          
          const imgUrl = this.imageUrlInput;
          const captionText = this.imageCaptionInput ? this.imageCaptionInput : '';
          const pos = this.imagePositionInput;
          
          const el = this.currentPage.elements[this.activeElementIndexForImage];
          let currentHtml = el.html || '';

          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = currentHtml;

          // 1. VERIFICARE SPECIALĂ: Dacă șablonul are un placeholder de poză dedicat (.template-img-box)
          const placeholderBox = tempDiv.querySelector('.template-img-box');
          if (placeholderBox && this.activeColumnIndexForImage === null && pos !== 'background') {
            let imgClasses = 'block w-full h-auto max-h-[450px] mx-auto rounded shadow-sm object-cover clear-both';
            if (pos === 'left') imgClasses = 'float-left mr-4 mb-3 w-[40%] max-w-[280px] h-auto rounded shadow-sm object-cover';
            if (pos === 'right') imgClasses = 'float-right ml-4 mb-3 w-[40%] max-w-[280px] h-auto rounded shadow-sm object-cover';

            const captionHtml = captionText ? `<span class="block text-[11px] text-stone-500 text-center mt-1 italic font-serif clear-both">${captionText}</span>` : '';
            const imgMarkup = `<img src="${imgUrl}" alt="Imagine" draggable="true" class="${imgClasses} cursor-move" />${captionHtml}`;

            // Înlocuim cutia cenușie direct cu imaginea generată, păstrând titlul și textul dedesubt
            placeholderBox.outerHTML = imgMarkup;
            el.html = tempDiv.innerHTML;
            this.saveCurrentPage();
            this.showImageModal = false;
            return;
          }
          // 1.5. VERIFICARE SPECIALĂ: Șablon cu imagine laterală în stânga (.template-side-img-box)
          const sidePlaceholderBox = tempDiv.querySelector('.template-side-img-box');
          if (sidePlaceholderBox && this.activeColumnIndexForImage === null && pos !== 'background') {
            let imgClasses = 'w-full h-52 rounded shadow-sm object-cover block';
            const captionHtml = captionText ? `<span class="block text-[11px] text-stone-500 text-center mt-1 italic font-serif">${captionText}</span>` : '';
            const imgMarkup = `<img src="${imgUrl}" alt="Imagine Laterală" draggable="true" class="${imgClasses} cursor-move" />${captionHtml}`;

            sidePlaceholderBox.outerHTML = imgMarkup;
            el.html = tempDiv.innerHTML;
            this.saveCurrentPage();
            this.showImageModal = false;
            return;
          }
          
          // 1.7. VERIFICARE SPECIALĂ: Șablon cu portret circular (.template-portrait-box)
          const portraitBox = tempDiv.querySelector('.template-portrait-box');
          if (portraitBox && this.activeColumnIndexForImage === null && pos !== 'background') {
            // Stiluri stricte pentru a asigura încadrarea perfectă și acoperirea cercului
