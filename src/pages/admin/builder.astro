       init() {
          if (sessionStorage.getItem('imaginea_lumii_auth') === 'true') {
            this.isAuthenticated = true;
          }

          const saved = localStorage.getItem('imaginea_lumii_pages');
          if (saved) {
            try {
              this.pages = JSON.parse(saved);
            } catch (e) {
              console.error(e);
            }
          }

          this.currentPage = this.pages[0];

          document.addEventListener('selectionchange', () => {
            const sel = window.getSelection();
            if (sel && sel.rangeCount > 0) {
              const range = sel.getRangeAt(0);
              if (!range.collapsed) {
                const anchor = sel.anchorNode;
                if (anchor && anchor.parentElement && anchor.parentElement.closest('[contenteditable="true"]')) {
                  this.savedRange = range.cloneRange();
                  this.currentSelectionText = sel.toString();
                }
              }
            }
          });
          this.saveCurrentPage();
        },
        
        login() {
          if (this.passwordInput === this.correctPassword) {
            this.isAuthenticated = true;
            sessionStorage.setItem('imaginea_lumii_auth', 'true');
          } else {
            alert('Parolă incorectă!');
          }
        },

        logout() {
          this.isAuthenticated = false;
          sessionStorage.removeItem('imaginea_lumii_auth');
          this.passwordInput = '';
        },

        switchPage() {
          const found = this.pages.find(p => p.slug === this.currentPageSlug);
          if (found) {
            this.currentPage = found;
          }
        },

        createNewPage() {
          const name = prompt('Numele paginii (ex: Contact, Arhivă):');
          if (name) {
            const slug = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
            const newPage = {
              slug: slug,
              title: name,
              headerType: 'minimal',
              footerType: 'minimal',
              headerTitle: name,
              footerText: '© 2026 ' + name,
              elements: [
                { html: `<h2 class="font-serif text-2xl font-bold text-stone-900">${name}</h2><p class="font-serif text-stone-600 mt-2">Conținut nou.</p>` }
              ]
            };
            this.pages.push(newPage);
            this.currentPageSlug = slug;
            this.currentPage = newPage;
            this.saveCurrentPage();
          }
        },
       
      deletePage(slug) {
          if (this.pages.length <= 1) return;
          
          const pageToDelete = this.pages.find(p => p.slug === slug);
          const pageTitle = pageToDelete ? pageToDelete.title : slug;

          if (confirm(`Sigur doriți să ștergeți pagina „${pageTitle}”? Această acțiune este ireversibilă.`)) {
            this.pages = this.pages.filter(p => p.slug !== slug);
            if (this.currentPageSlug === slug) {
              this.currentPageSlug = this.pages[0].slug;
              this.currentPage = this.pages[0];
            }
            this.saveCurrentPage();
          }
        },       
        
        movePageUp(index) {
          if (index > 0) {
            const temp = this.pages[index];
            this.pages[index] = this.pages[index - 1];
            this.pages[index - 1] = temp;
            this.saveCurrentPage();
          }
        },

        movePageDown(index) {
          if (index < this.pages.length - 1) {
            const temp = this.pages[index];
            this.pages[index] = this.pages[index + 1];
            this.pages[index + 1] = temp;
            this.saveCurrentPage();
          }
        },

        togglePageVisibility(index) {
          if (this.pages[index]) {
            const currentStatus = this.pages[index].isPublished !== false;
            this.pages[index].isPublished = !currentStatus;
            this.saveCurrentPage();
          }
        },
        
        openModal(modalName) {
          this.activeModal = modalName;
        },

        closeModal() {
          this.activeModal = null;
        },

       addTemplate(index) {
          if (this.pageTemplates && this.pageTemplates[index]) {
            // Adăugăm direct elementul în pagină și salvăm
            this.currentPage.elements.push({ html: this.pageTemplates[index].html });
            this.saveCurrentPage();
          }
          this.closeModal();
        },

        addComponent(component) {
          if (component && component.html) {
            this.currentPage.elements.push({ html: component.html });
            this.saveCurrentPage();
          }
          this.closeModal(); // Închide modalul instant după inserare
        },

        removeElement(index) {
          this.currentPage.elements.splice(index, 1);
          this.saveCurrentPage();
        },
        
          // 1. Când începi să tragi o imagine
        onDragStart(event) {
          if (event.target.tagName === 'IMG') {
            event.dataTransfer.effectAllowed = 'move';
            
            let htmlToMove = event.target.outerHTML;
            const nextSibling = event.target.nextElementSibling;
            if (nextSibling && nextSibling.tagName === 'SPAN' && nextSibling.classList.contains('italic')) {
              htmlToMove += nextSibling.outerHTML;
              nextSibling.remove();
            }
            
            event.dataTransfer.setData('text/html', htmlToMove);
            event.target.remove();
          }
        },

        // 2. Permite drop-ul
        onDragOver(event) {
          event.preventDefault();
          event.dataTransfer.dropEffect = 'move';
        },

        // 3. Când plasezi imaginea
        onDropImage(event, index) {
          event.preventDefault();
          
          const htmlData = event.dataTransfer.getData('text/html');
          if (!htmlData) return;

          const containerDivs = document.querySelectorAll('.prose');
          const containerDiv = containerDivs[index];
          if (!containerDiv) return;

          let range = null;
          if (document.caretRangeFromPoint) {
            range = document.caretRangeFromPoint(event.clientX, event.clientY);
          }

          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = htmlData;
          const frag = document.createDocumentFragment();
          let node;
          while ((node = tempDiv.firstChild)) {
            frag.appendChild(node);
          }

          if (range && containerDiv.contains(range.commonAncestorContainer)) {
            range.deleteContents();
            range.insertNode(frag);
          } else {
            containerDiv.appendChild(frag);
          }

          this.currentPage.elements[index].html = containerDiv.innerHTML;
          this.saveCurrentPage();
        },

        // 4. Finalizare drag
        onDragEnd(event) {
          // Metodă menținută pentru curățenia evenimentului
        },
        
        

        // --- ADaugă-le AICI, în Script ---
       setElementWidth(index, widthValue) {
          const el = this.currentPage.elements[index];
          let styleStr = el.style || '';
          
          // Actualizăm width
          if (styleStr.includes('width:')) {
            styleStr = styleStr.replace(/width:\s*[^;]+;?/, `width: ${widthValue};`);
          } else {
            styleStr += ` width: ${widthValue};`;
          }
          
          // Dacă lățimea este mai mică de 100%, adăugăm display: inline-block / flex item support
          if (!styleStr.includes('box-sizing')) {
            styleStr += ' box-sizing: border-box;';
          }
          
          el.style = styleStr;
          this.saveCurrentPage();
        },

toggleCenterWidth(index) {
          const el = this.currentPage.elements[index];
          let styleStr = el.style || '';
          if (styleStr.includes('margin-left: auto') || styleStr.includes('margin-left:auto')) {
            styleStr = styleStr.replace(/margin-left:\s*auto;?/, '').replace(/margin-right:\s*auto;?/, '').trim();
          } else {
            styleStr += ' margin-left: auto; margin-right: auto;';
          }
          el.style = styleStr;
          this.saveCurrentPage();
        },




        adjustOffset(index, deltaPixels) {
          const el = this.currentPage.elements[index];
          let currentMargin = 0;
          if (el.style) {
            const match = el.style.match(/margin-left:\s*(-?\d+)px/);
            if (match) currentMargin = parseInt(match[1], 10);
          }
          const newMargin = currentMargin + deltaPixels;
          // Păstrăm lățimea existentă și adăugăm margin-left
          if (!el.style.includes('margin-left')) {
            el.style = (el.style || '') + ` margin-left: ${newMargin}px;`;
          } else {
            el.style = el.style.replace(/margin-left:\s*(-?\d+)px/, `margin-left: ${newMargin}px;`);
          }
          this.saveCurrentPage();
        },

        resetOffset(index) {
          const el = this.currentPage.elements[index];
          if (el && el.style) {
            // Elimina doar regula de margin-left, pastrand latimea aleasa
            el.style = el.style.replace(/margin-left:\s*[^;]+;?/g, '').trim();
          }
          this.saveCurrentPage();
        },

        moveUp(index) {
          if (index > 0) {
            const temp = this.currentPage.elements[index];
            this.currentPage.elements[index] = this.currentPage.elements[index - 1];
            this.currentPage.elements[index - 1] = temp;
            this.saveCurrentPage();
          }
        },

        moveDown(index) {
          if (index < this.currentPage.elements.length - 1) {
            const temp = this.currentPage.elements[index];
            this.currentPage.elements[index] = this.currentPage.elements[index + 1];
            this.currentPage.elements[index + 1] = temp;
            this.saveCurrentPage();
          }
        },

     executeTipTapCommand(command) {
            // Găsim editorul TipTap activ din pagină
            const activeContainer = document.querySelector('.prose [contenteditable="true"]');
            if (activeContainer && activeContainer._tiptapEditor) {
                const editor = activeContainer._tiptapEditor;
                if (command === 'bold') editor.chain().focus().toggleBold().run();
                if (command === 'italic') editor.chain().focus().toggleItalic().run();
                if (command === 'underline') editor.chain().focus().toggleUnderline().run();
                if (command === 'strike') editor.chain().focus().toggleStrike().run();
            } else {
                // Alternativ, dacă editorul nu este direct accesibil, folosim selecția nativă
                if (!this.savedRange) {
                    alert('Vă rugăm să selectați mai întâi un text în editor!');
                    return;
                }
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(this.savedRange);
                document.execCommand(command, false, null);
                this.saveCurrentPage();
            }
        },
    
       applyAlignment(command) {
          if (!this.savedRange) {
            alert('Vă rugăm să selectați mai întâi un text în editor!');
            return;
          }
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(this.savedRange);
          
          // Mapăm comenzile pentru aliniere nativă
          let cssAlign = 'left';
          if (command === 'justifyCenter') cssAlign = 'center';
          if (command === 'justifyRight') cssAlign = 'right';
          if (command === 'justifyFull') cssAlign = 'justify';

          const range = selection.getRangeAt(0);
          const span = document.createElement('span');
          span.style.display = 'block';
          span.style.textAlign = cssAlign;
          span.appendChild(range.extractContents());
          range.insertNode(span);

          selection.removeAllRanges();
          this.savedRange = null;
          this.currentSelectionText = '';
          this.saveCurrentPage();
        },

   applyAllCustomStyles() {
          const selection = window.getSelection();
          if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
            alert('Vă rugăm să selectați mai întâi textul din coloană!');
            return;
          }

          if (!this.selectedFont && !this.selectedSize && !this.selectedColor && !this.selectedTransform && !this.selectedDropCap && !this.selectedLineHeight && !this.selectedWordSpacing && !this.selectedLetterSpacing) {
            alert('Vă rugăm alegeți cel puțin o opțiune tipografică!');
            return;
          }

          const range = selection.getRangeAt(0);
          
          // Folosim un container temporar sigur pentru a nu rupe blocurile HTML (paragrafele sau rândurile multiple)
          const span = document.createElement('span');
          
          if (this.selectedFont) span.style.fontFamily = this.selectedFont;
          if (this.selectedSize) span.style.fontSize = this.selectedSize;
          if (this.selectedColor) span.style.color = this.selectedColor;
          if (this.selectedTransform) span.style.textTransform = this.selectedTransform;
          if (this.selectedLineHeight) span.style.lineHeight = this.selectedLineHeight;
          if (this.selectedWordSpacing) span.style.wordSpacing = this.selectedWordSpacing;
          if (this.selectedLetterSpacing) span.style.letterSpacing = this.selectedLetterSpacing;

          if (this.selectedDropCap) {
            const dropCapStyles = {
              'dc-classic': { fontSize: '3.2rem', color: '#1c1917', fontFamily: '"Cormorant Garamond", serif', lineHeight: '0.8', float: 'left', marginRight: '8px', paddingRight: '2px' },
              'dc-gold': { fontSize: '3.5rem', color: '#b45309', fontWeight: 'bold', fontFamily: '"Playfair Display", serif', lineHeight: '0.8', float: 'left', marginRight: '8px' },
              'dc-box-dark': { fontSize: '2.2rem', backgroundColor: '#1c1917', color: '#ffffff', padding: '4px 10px', borderRadius: '4px', lineHeight: '1', float: 'left', marginRight: '8px' },
              'dc-box-amber': { fontSize: '2.2rem', backgroundColor: '#b45309', color: '#ffffff', padding: '4px 10px', borderRadius: '4px', lineHeight: '1', float: 'left', marginRight: '8px' },
              'dc-serif-bold': { fontSize: '3.8rem', fontWeight: '900', color: '#7f1d1d', fontFamily: '"EB Garamond", serif', lineHeight: '0.8', float: 'left', marginRight: '8px' },
              'dc-gothic': { fontSize: '3.6rem', color: '#1c1917', fontFamily: '"Cinzel", serif', fontWeight: 'bold', lineHeight: '0.8', float: 'left', marginRight: '8px' },
              'dc-circle': { fontSize: '2rem', backgroundColor: '#78350f', color: '#ffffff', borderRadius: '9999px', width: '45px', height: '45px', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', float: 'left', marginRight: '8px' },
              'dc-handwritten': { fontSize: '3.5rem', color: '#b45309', fontFamily: '"Playpen Sans", cursive', lineHeight: '0.8', float: 'left', marginRight: '8px' }
            };

            if (dropCapStyles[this.selectedDropCap]) {
              Object.assign(span.style, {
                display: 'inline-block',
                ...dropCapStyles[this.selectedDropCap]
              });
            }
          }

          try {
            // Extragem conținutul în mod sigur, prevenind spaghettele HTML pe rânduri multiple
            const contents = range.extractContents();
            span.appendChild(contents);
            range.insertNode(span);
          } catch (e) {
            console.error("Eroare sigură la stilizare multi-rând:", e);
          }

          selection.removeAllRanges();
          this.savedRange = null;
          this.currentSelectionText = '';

          // Găsim exact caseta .prose părinte fără să afectăm restul paginii
          const editableBox = span.closest('[contenteditable="true"]');
          if (editableBox) {
            const parentProse = editableBox.closest('.prose');
            const proseDivs = Array.from(document.querySelectorAll('.prose'));
            const index = proseDivs.indexOf(parentProse);

            if (index !== -1 && this.currentPage.elements[index]) {
              this.currentPage.elements[index].html = parentProse.innerHTML;
            }
          }

          // Resetăm opțiunile
          this.selectedFont = '';
          this.selectedSize = '';
          this.selectedColor = '';
          this.selectedTransform = '';
          this.selectedDropCap = '';
          this.selectedLineHeight = '';
          this.selectedWordSpacing = '';
          this.selectedLetterSpacing = '';

          this.saveCurrentPage();
        },
        
        updateElementHtml(event, index, targetField = null) {
          const newHtml = event.target.innerHTML;
          if (targetField === 'headerTitle') {
            this.currentPage.headerTitle = newHtml;
          } else if (targetField === 'headerMetaLeft') {
            this.currentPage.headerMetaLeft = newHtml;
          } else if (targetField === 'headerMetaCenter') {
            this.currentPage.headerMetaCenter = newHtml;
          } else if (targetField === 'headerMetaRight') {
            this.currentPage.headerMetaRight = newHtml;
          } else if (targetField === 'footerText') {
            this.currentPage.footerText = newHtml;
          } else if (index !== null && this.currentPage.elements[index]) {
            this.currentPage.elements[index].html = newHtml;
          }
          this.saveCurrentPage();
        },

async saveCurrentPage() {
          try {
            // 1. Salvare locală (backup de siguranță)
            const currentState = JSON.stringify(this.pages);
            if (this.pageHistory.length === 0 || this.pageHistory[this.pageHistory.length - 1] !== currentState) {
              this.pageHistory.push(currentState);
              if (this.pageHistory.length > 5) {
                this.pageHistory.shift();
              }
            }
            localStorage.setItem('imaginea_lumii_pages', currentState);

            // 2. Salvare în Supabase (Cloud Sync)
            if (window.supabaseClient) {
              const sb = window.supabaseClient;

              // Salvăm fiecare pagină în tabela `pages`
              for (const p of this.pages) {
                const pagePayload = {
                  id: p.id || p.slug, // folosim slug-ul sau id-ul ca identificator unic
                  slug: p.slug,
                  title: p.title,
                  is_fixed: p.is_fixed || false,
                  hidden: p.isPublished === false, // mapăm starea de publicare pe coloana hidden din DB
                  sort_order: this.pages.indexOf(p),
                  header_type: p.headerType || 'classic',
                  footer_type: p.footerType || 'full'
                };

                const { error: pageError } = await sb
                  .from('pages')
                  .upsert(pagePayload, { onConflict: 'slug' });

                if (pageError) {
                  console.error("Eroare la salvarea paginii în Supabase:", pageError);
                } else {
                  // Dacă pagina s-a salvat, salvăm și blocurile (elementele) ei în tabela `blocks`
                  // Mai întâi ștergem blocurile vechi pentru această pagină ca să le reînnoim curat
                  const pageId = pagePayload.id;

                  // Salvăm elementele curente
                  if (p.elements && Array.isArray(p.elements)) {
                    // Opțional: putem face upsert sau re-inserare curată
                    for (let i = 0; i < p.elements.length; i++) {
                      const el = p.elements[i];
                      const blockPayload = {
                        id: el.id || `${p.slug}-block-${i}`,
                        page_id: pageId,
                        type: el.type || 'html',
                        sort_order: i,
                        content: { html: el.html, style: el.style || '' },
                        hidden: false
                      };

                      await sb.from('blocks').upsert(blockPayload, { onConflict: 'id' });
                    }
                  }
                }
              }
              console.log("Sincronizarea cu Supabase s-a efectuat cu succes!");
            }
          } catch (e) {
            console.warn("Eroare la salvare:", e);
          }
        },
undoLastAction() {
          if (this.pageHistory.length <= 1) {
            alert('Nu mai există nicio acțiune anterioară în memorie pentru undo!');
            return;
          }
          
          // Aruncăm starea curentă din vârf
          this.pageHistory.pop(); 
          
          // Luăm starea anterioară
          const previousState = this.pageHistory[this.pageHistory.length - 1];
          this.pages = JSON.parse(previousState);
          
          // Re-sincronizăm pagina curentă cu slug-ul activ
          const found = this.pages.find(p => p.slug === this.currentPageSlug);
          if (found) {
            this.currentPage = found;
          } else {
            this.currentPage = this.pages[0];
          }

          localStorage.setItem('imaginea_lumii_pages', JSON.stringify(this.pages));
        },

        exportBackup() {
          const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(this.pages, null, 2));
          const downloadAnchor = document.createElement('a');
          downloadAnchor.setAttribute("href", dataStr);
          downloadAnchor.setAttribute("download", "imaginea_lumii_backup_" + new Date().toISOString().slice(0,10) + ".json");
          document.body.appendChild(downloadAnchor);
          downloadAnchor.click();
          downloadAnchor.remove();
        },
        importBackup(event) {
          const fileReader = new FileReader();
          if (event.target.files[0]) {
            fileReader.readAsText(event.target.files[0], "UTF-8");
            fileReader.onload = (e) => {
              try {
                const importedPages = JSON.parse(e.target.result);
                if (Array.isArray(importedPages)) {
                  this.pages = importedPages;
                  this.currentPageSlug = this.pages[0].slug;
                  this.currentPage = this.pages[0];
                  this.saveCurrentPage();
                  alert('Backup-ul a fost încărcat și salvat cu succes!');
                } else {
                  alert('Fișierul JSON nu are structura corectă.');
                }
              } catch (error) {
                alert('Eroare la citirea fișierului JSON: ' + error.message);
              }
            };
          }
        }
      }
    }
    </script>
    <!-- Modal Inserare Imagine -->
<div 
  x-show="showImageModal" 
  x-cloak
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 font-sans"
>
  <div @click.away="showImageModal = false" class="bg-stone-900 border border-stone-700 rounded-lg max-w-md w-full p-6 text-stone-200 shadow-2xl">
    <div class="flex justify-between items-center border-b border-stone-800 pb-3 mb-4">
      <h3 class="font-serif text-lg font-bold text-amber-400">🖼️ Inserare Imagine în Șablon</h3>
      <button @click="showImageModal = false" class="text-stone-400 hover:text-white font-bold">✕</button>
    </div>

    <!-- Tab-uri Sursă -->
    <div class="flex gap-2 mb-4 border-b border-stone-800 pb-2">
      <button 
        @click="imageTab = 'url'" 
        :class="imageTab === 'url' ? 'bg-amber-700 text-white' : 'bg-stone-800 text-stone-400 hover:bg-stone-700'"
        class="px-3 py-1 text-xs font-semibold rounded"
      >
        Link URL (Web / Supabase)
      </button>
      <button 
        @click="imageTab = 'upload'" 
        :class="imageTab === 'upload' ? 'bg-amber-700 text-white' : 'bg-stone-800 text-stone-400 hover:bg-stone-700'"
        class="px-3 py-1 text-xs font-semibold rounded"
      >
        Upload Calculator
      </button>
    </div>

    <!-- Câmp URL -->
    <div x-show="imageTab === 'url'" class="mb-4">
      <label class="block text-xs text-stone-400 mb-1">Adresă URL Imagine:</label>
      <input 
        type="url" 
        x-model="imageUrlInput" 
        placeholder="https://images.unsplash.com/... sau URL Supabase" 
        class="w-full px-3 py-2 text-xs bg-stone-800 border border-stone-700 rounded text-stone-100 focus:outline-none focus:border-amber-500" 
      />
    </div>

    <!-- Câmp Upload -->
    <div x-show="imageTab === 'upload'" class="mb-4">
      <label class="block text-xs text-stone-400 mb-1">Alege fișierul de pe PC:</label>
      <input 
        type="file" 
        accept="image/*" 
        @change="handleFileUpload($event)" 
        class="w-full text-xs text-stone-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-amber-800 file:text-amber-100 hover:file:bg-amber-700 cursor-pointer" 
      />
    </div>

    <!-- Poziționare & Stil -->
    <div class="mb-4">
      <label class="block text-xs text-stone-400 mb-1">Poziție în Șablon:</label>
      <select x-model="imagePositionInput" class="w-full px-3 py-2 text-xs bg-stone-800 border border-stone-700 rounded text-amber-300 focus:outline-none">
        <option value="center">Centrat pe rând (Standard)</option>
        <option value="left">Stânga textului (Float Left)</option>
        <option value="right">Dreapta textului (Float Right)</option>
        <option value="top">Antet deasupra (Cover Top)</option>
        <option value="background">Fundal în spatele textului (Overlay)</option>
      </select>
    </div>

    <!-- ===== AICI ESTE NOUL PAS: Opțiune pentru caseta de text (Apare doar la fundal) ===== -->
    <div x-show="imagePositionInput === 'background'" class="mb-4 p-3 bg-stone-950 border border-stone-800 rounded">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" x-model="removeTextBackground" class="rounded bg-stone-800 border-stone-700 text-amber-600 focus:ring-0">
        <span class="text-xs text-stone-300 font-medium">Elimină caseta de fundal (Textul plutește direct pe poză)</span>
      </label>
    </div>
    <!-- ============================================================================== -->

    <!-- Legendă / Subtitlu -->
    <div class="mb-6">
      <label class="block text-xs text-stone-400 mb-1">Subtitlu / Legendă (Opțional):</label>
      <input 
        type="text" 
        x-model="imageCaptionInput" 
        placeholder="Ex: Foto: Arhiva personală / Unsplash" 
        class="w-full px-3 py-2 text-xs bg-stone-800 border border-stone-700 rounded text-stone-100 focus:outline-none focus:border-amber-500" 
      />
    </div>

    <!-- Previzualizare rapidă -->
    <template x-if="imageUrlInput">
      <div class="mb-4 p-2 bg-stone-950 border border-stone-800 rounded text-center">
        <span class="text-[10px] text-stone-500 block mb-1">Previzualizare:</span>
        <img :src="imageUrlInput" class="max-h-32 mx-auto rounded object-cover" />
      </div>
    </template>

    <!-- Acțiuni -->
    <div class="flex justify-end gap-3 pt-2 border-t border-stone-800">
      <button @click="showImageModal = false" class="px-4 py-2 text-xs bg-stone-800 hover:bg-stone-700 text-stone-300 rounded font-semibold">Anulează</button>
      <button @click="insertImageToElement()" :disabled="!imageUrlInput" class="px-4 py-2 text-xs bg-emerald-700 hover:bg-emerald-600 disabled:opacity-50 text-white rounded font-bold transition">Adaugă Imaginea</button>
    </div>
  </div>
</div>
  
</BaseLayout>
