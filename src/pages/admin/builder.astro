---
import BaseLayout from '../../layouts/BaseLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KE
---
<BaseLayout title="Visual Builder - Studio Tipografic">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather:ital,wght@0,300;0,700;1,300&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600&family=Space+Grotesk:wght@400;600&family=Special+Elite&family=Playpen+Sans&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,700;1,6..72,400&family=Cardo:ital,wght@0,400;0,700;1,400&family=Baskervville:ital@0;1&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Amatic+SC:wght@700&family=Rozha+One&family=Italiana&family=Prata&family=Syne:wght@500;700&display=swap" rel="stylesheet">
  </Fragment>
</BaseLayout>

  <div x-data="adminApp()" class="flex h-screen flex-col overflow-hidden bg-[#FBF9F5]">

    <!-- 1. ECRANUL DE LOGIN -->
    <template x-if="!isAuthenticated">
      <div class="flex flex-1 items-center justify-center bg-stone-900 px-4">
        <div class="max-w-md w-full bg-white p-8 rounded shadow-xl border border-stone-300">
          <div class="text-center mb-6">
            <h2 class="font-serif text-2xl font-bold text-stone-900">Imaginea Lumii</h2>
            <p class="text-xs uppercase tracking-widest text-stone-500 font-sans mt-1">Studio Tipografic Protejat</p>
          </div>
          
          <form @submit.prevent="login()" class="space-y-4">
            <div>
              <label class="block text-xs uppercase font-sans font-bold text-stone-700 mb-1">Parolă Administrator</label>
              <input 
                type="password" 
                x-model="passwordInput" 
                placeholder="Introduceți parola..." 
                class="w-full px-3 py-2 border border-stone-300 rounded text-sm focus:outline-none focus:border-amber-600 font-serif"
                required
              />
            </div>
            <button type="submit" class="w-full bg-amber-600 hover:bg-amber-500 text-white py-2.5 text-xs uppercase font-bold tracking-wider rounded transition shadow-sm">
              Autentificare
            </button>
            <div class="text-center mt-4">
              <a href="/" class="text-xs text-stone-500 hover:text-stone-900 underline">← Înapoi la Revista Publică</a>
            </div>
          </form>
        </div>
      </div>
    </template>

    <!-- 2. INTERFAȚA BUILDERULUI -->
    <div x-show="isAuthenticated" class="flex h-screen flex-col overflow-hidden bg-[#FBF9F5]" style="display: none;" :style="isAuthenticated ? 'display: flex;' : 'display: none;'">
      
      <!-- Top Bar -->
      <header class="bg-stone-900 text-white px-6 py-3 flex justify-between items-center border-b border-stone-800 shadow-md z-20">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs uppercase tracking-wider text-stone-400 hover:text-white transition">← Vezi Revista Live</a>
          <h1 class="font-serif text-lg tracking-wide border-l border-stone-700 pl-4">Imaginea Lumii — <span class="text-amber-400 font-sans text-xs uppercase font-semibold">Studio Tipografic Profesional</span></h1>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 bg-stone-800 px-3 py-1.5 rounded border border-stone-700 text-xs">
            <span class="text-stone-400">Pagină:</span>
            <select x-model="currentPageSlug" @change="switchPage()" class="bg-transparent text-amber-300 font-semibold focus:outline-none cursor-pointer">
              <template x-for="p in pages" :key="p.slug">
                <option :value="p.slug" x-text="p.title" class="bg-stone-900 text-white"></option>
              </template>
            </select>
          </div>

          <button @click="createNewPage()" class="bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 px-3 py-1.5 text-xs font-sans rounded transition">
            + Pagină
          </button>

          <button @click="exportBackup()" class="bg-stone-800 hover:bg-stone-700 text-amber-300 border border-stone-700 px-3 py-1.5 text-xs font-sans rounded transition" title="Export Backup">
            📥 Export
          </button>

          <label class="bg-stone-800 hover:bg-stone-700 text-emerald-400 border border-stone-700 px-3 py-1.5 text-xs font-sans rounded transition cursor-pointer" title="Import Backup">
            📤 Import
            <input type="file" accept=".json" @change="importBackup($event)" class="hidden" />
          </label>

          <button @click="saveCurrentPage()" class="bg-amber-600 hover:bg-amber-500 text-white px-4 py-1.5 text-xs uppercase tracking-wider font-bold transition rounded shadow-sm">
            💾 Salvează
          </button>

          <button @click="logout()" class="text-stone-400 hover:text-red-400 text-xs uppercase tracking-wider ml-2 border-l border-stone-700 pl-3 transition">
            Ieșire
          </button>
        </div>
      </header>

      <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-80 bg-stone-100 border-r border-stone-300 flex flex-col overflow-y-auto">
          <div class="flex border-b border-stone-300 bg-stone-200 text-[11px] font-semibold">
            <button @click="activeTab = 'sections'" :class="activeTab === 'sections' ? 'bg-stone-100 border-b-2 border-amber-600 text-stone-900' : 'text-stone-600 hover:text-stone-900'" class="flex-1 py-3 px-1 text-center transition">
              1. Secțiuni
            </button>
            <button @click="activeTab = 'studio'" :class="activeTab === 'studio' ? 'bg-stone-100 border-b-2 border-amber-600 text-stone-900' : 'text-stone-600 hover:text-stone-900'" class="flex-1 py-3 px-1 text-center transition font-bold text-amber-900">
              2. ✍️ Studio Text
            </button>
            <button @click="activeTab = 'global'" :class="activeTab === 'global' ? 'bg-stone-100 border-b-2 border-amber-600 text-stone-900' : 'text-stone-600 hover:text-stone-900'" class="flex-1 py-3 px-1 text-center transition">
              3. Global
            </button>
          
<button @click="activeTab = 'pages'" :class="activeTab === 'pages' ? 'bg-stone-100 border-b-2 border-amber-600 text-stone-900' : 'text-stone-600 hover:text-stone-900'" class="flex-1 py-3 px-1 text-center transition">
              4. 🗂️ Pagini
            </button>
            </div>
           <!-- TAB 1: Secțiuni & Elemente Modulare -->
          <div x-show="activeTab === 'sections'" class="p-4 flex flex-col gap-4">
            <h2 class="text-xs uppercase font-sans tracking-widest text-stone-500 font-bold">Panou Elemente Editoriale</h2>
            
            <!-- 1. Buton Dreptunghiular Lat (Full Width): Şabloane Pagini -->
            <button 
              @click="openModal('templates')" 
              class="w-full bg-stone-900 hover:bg-stone-800 text-white p-4 rounded-md shadow-sm flex items-center justify-between group transition cursor-pointer"
            >
              <div class="flex items-center gap-3">
                <span class="text-xl">📑</span>
                <div class="text-left font-serif">
                  <span class="font-bold text-sm block leading-tight">Șabloane Pagini</span>
                  <span class="text-[10px] text-stone-400 font-sans uppercase">Machete gata de utilizare</span>
                </div>
              </div>
              <span class="text-amber-400 text-xs font-sans group-hover:translate-x-1 transition font-bold">Deschide →</span>
            </button>

            <div class="border-t border-stone-200 my-1"></div>

       <!-- Grilă 2 coloane cu Inline CSS (Ocolește orice problemă de compilare Tailwind) -->
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;" class="w-full">
              
              <!-- 1. Separatoare -->
              <button 
                @click="openModal('separators')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">⁘</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Separatoare</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-0.5">30 Vert. / 30 Oriz.</span>
              </button>

              <!-- 2. Bannere -->
              <button 
                @click="openModal('banners')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">📜</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Bannere</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-0.5">10 Stiluri Unice</span>
              </button>

              <!-- 3. Galerie Foto -->
              <button 
                @click="openModal('gallery')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">🖼️</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Galerie Foto</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-0.5">Grid & Carusel</span>
              </button>

              <!-- 4. Video Media -->
              <button 
                @click="openModal('video')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">🎥</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Video Media</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-0.5">Link / Upload</span>
              </button>

              <!-- 5. Audio Player -->
              <button 
                @click="openModal('audio')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">🎙️</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Audio Player</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-0.5">Podcast / Articol</span>
              </button>

              <!-- 6. Cifre & Date -->
              <button 
                @click="openModal('stats')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">📊</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Cifre & Date</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-1">Infografice & Stats</span>
              </button>
              <!-- 7. Surse & Presă Internațională -->
              <button 
                @click="openModal('sources')" 
                style="aspect-ratio: 1 / 1;"
                class="bg-white hover:bg-stone-50 border border-stone-300 hover:border-amber-600 rounded-md flex flex-col items-center justify-center text-center group transition cursor-pointer shadow-sm p-2 overflow-hidden"
              >
                <span class="text-2xl mb-1 group-hover:scale-110 transition">📋</span>
                <span class="font-serif font-bold text-[11px] text-stone-900 leading-tight">Surse Presă</span>
                <span class="text-[8px] text-stone-400 font-sans uppercase mt-1">Sinteză & Autori</span>
              </button>
              
              

            </div>
            </div>

        <!-- TAB 2: Studio Tipografic -->
          <div x-show="activeTab === 'studio'" class="p-4 flex flex-col gap-4 text-xs">
          
          <!-- Butonul de Undo inserat aici -->
            <button @click="undoLastAction()" class="bg-stone-200 hover:bg-stone-300 text-stone-800 px-3 py-1.5 rounded text-xs font-bold transition flex items-center gap-1">
              ↩ Anulează (Undo)
            </button>
            
            <div class="bg-amber-100/70 p-3 border border-amber-300 rounded text-amber-900 leading-relaxed">
              ✨ <strong>Mod de lucru:</strong><br/>
              1. Selectează textul din pagină.<br/>
              2. Alege fontul, mărimea, culoarea sau litera decorativă.<br/>
              3. Apasă <strong>„Aplică Stilul pe Text”</strong>!
            </div>

            <div class="bg-white p-2.5 border border-stone-300 rounded shadow-2xs">
              <span class="text-[10px] uppercase font-bold text-stone-400 block mb-1">Text selectat activ în memorie:</span>
              <span class="font-serif text-amber-800 font-semibold italic truncate block max-w-full" x-text="currentSelectionText ? '„' + currentSelectionText + '„' : 'Niciun text selectat'"></span>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Stiluri rapide</label>
              <div class="grid grid-cols-4 gap-1">
                <button type="button" @click="executeTipTapCommand('bold')" class="bg-white border border-stone-300 py-1.5 font-bold hover:bg-stone-900 hover:text-white rounded transition">B</button>
                <button type="button" @click="executeTipTapCommand('italic')" class="bg-white border border-stone-300 py-1.5 italic hover:bg-stone-900 hover:text-white rounded transition">I</button>
                <button type="button" @click="executeTipTapCommand('underline')" class="bg-white border border-stone-300 py-1.5 underline hover:bg-stone-900 hover:text-white rounded transition">U</button>
                <button type="button" @click="executeTipTapCommand('strike')" class="bg-white border border-stone-300 py-1.5 line-through hover:bg-stone-900 hover:text-white rounded transition">S</button>
              </div>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Alege Fontul</label>
              <select x-model="selectedFont" class="w-full bg-white border border-stone-300 p-2 font-serif rounded focus:outline-none focus:border-amber-600">
                <option value="">-- Păstrează fontul curent --</option>
                <template x-for="f in fontList" :key="f.value">
                  <option :value="f.value" x-text="f.name" :style="'font-family: ' + f.value"></option>
                </template>
              </select>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Mărime Font</label>
              <select x-model="selectedSize" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600">
                <option value="">-- Păstrează mărimea curentă --</option>
                <template x-for="s in sizeList" :key="s">
                  <option :value="s + 'px'" x-text="s + ' px'"></option>
                </template>
              </select>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Culoare Text</label>
              <select x-model="selectedColor" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600 mb-2">
                <option value="">-- Păstrează culoarea curentă --</option>
                <template x-for="c in colorList" :key="c.value">
                  <option :value="c.value" x-text="c.name" :style="'color: ' + c.value"></option>
                </template>
              </select>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Aliniere Text</label>
              <div class="grid grid-cols-4 gap-1">
                <button @click="applyAlignment('justifyLeft')" class="bg-white border border-stone-300 py-1.5 hover:bg-stone-900 hover:text-white rounded transition" title="Stânga">⬅</button>
                <button @click="applyAlignment('justifyCenter')" class="bg-white border border-stone-300 py-1.5 hover:bg-stone-900 hover:text-white rounded transition" title="Centru">⬌</button>
                <button @click="applyAlignment('justifyRight')" class="bg-white border border-stone-300 py-1.5 hover:bg-stone-900 hover:text-white rounded transition" title="Dreapta">➡</button>
                <button @click="applyAlignment('justifyFull')" class="bg-white border border-stone-300 py-1.5 hover:bg-stone-900 hover:text-white rounded transition" title="Justificat">≡</button>
              </div>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Transformare Text</label>
              <select x-model="selectedTransform" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600">
                <option value="">-- Fără transformare --</option>
                <option value="uppercase">MAJUSCULE</option>
                <option value="lowercase">litere mici</option>
                <option value="capitalize">Capitalizează</option>
                <option value="none">Normal</option>
              </select>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Literă Decorativă (Drop Cap)</label>
              <select x-model="selectedDropCap" class="w-full bg-white border border-stone-300 p-2 font-serif rounded focus:outline-none focus:border-amber-600 mb-2">
                <option value="">-- Fără literă decorativă --</option>
                <option value="dc-classic">1. Clasic Garamond (Mare & Elegant)</option>
                <option value="dc-gold">2. Auriu Regal (Chihlimbar)</option>
                <option value="dc-box-dark">3. Casetă Neagră (Modernist)</option>
                <option value="dc-box-amber">4. Casetă Chihlimbar</option>
                <option value="dc-serif-bold">5. Extra-Bold Serif (Roșu Bordeaux)</option>
                <option value="dc-gothic">6. Gothic / Roman Monumental</option>
                <option value="dc-circle">7. Cerc Sepia Vintage</option>
                <option value="dc-handwritten">8. Scris de mână (Playpen)</option>
              </select>
            </div>
            
            <!-- Spațieri Tipografice Avansate -->
            <div class="border-t border-stone-200 pt-3 mt-3">
              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Spațiere Rânduri (Line-Height)</label>
              <select x-model="selectedLineHeight" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600 mb-2">
                <option value="">-- Implicit (Normal) --</option>
                <option value="1.2">1.2 (Compact)</option>
                <option value="1.4">1.4 (Echilibrat)</option>
                <option value="1.6">1.6 (Lărgit / Revistă)</option>
                <option value="1.8">1.8 (Aerisit)</option>
                <option value="2.0">2.0 (Dublu)</option>
              </select>

              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Spațiere Cuvinte (Word-Spacing)</label>
              <select x-model="selectedWordSpacing" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600 mb-2">
                <option value="">-- Implicit (Normal) --</option>
                <option value="1px">1 px</option>
                <option value="2px">2 px</option>
                <option value="4px">4 px (Rărit)</option>
                <option value="6px">6 px (Extins)</option>
              </select>

              <label class="block uppercase font-bold text-stone-700 mb-1 tracking-wider">Spațiere Litere / Kerning (Letter-Spacing)</label>
              <select x-model="selectedLetterSpacing" class="w-full bg-white border border-stone-300 p-2 rounded focus:outline-none focus:border-amber-600">
                <option value="">-- Implicit (Normal) --</option>
                <option value="-0.05em">Strâns (-0.05em)</option>
                <option value="0.05em">Ușor Rărit (0.05em)</option>
                <option value="0.1em">Moderat (0.1em)</option>
                <option value="0.2em">Titlu / Majuscule (0.2em)</option>
                <option value="0.3em">Extrem de Rărit (0.3em)</option>
              </select>
            </div>
            
            

            <button @click="applyAllCustomStyles()" class="w-full bg-amber-700 hover:bg-amber-600 text-white py-3 font-bold uppercase tracking-wider rounded shadow transition mt-2">
              ✨ Aplică Stilul pe Text
            </button>
          </div>

                <!-- TAB 3: Global -->
          <div x-show="activeTab === 'global'" class="p-4 flex flex-col gap-6 text-xs">
            <div>
              <label class="block uppercase font-bold text-stone-700 mb-2">Model Header / Meniu</label>
              <select x-model="currentPage.headerType" @change="saveCurrentPage()" class="w-full bg-white border border-stone-300 p-2 font-serif rounded focus:outline-none">
                <option value="classic">1. Clasic Gazetă (Newspaper)</option>
                <option value="minimal">2. Minimalist Modern</option>
                <option value="luxe">3. Revistă de Artă (Editorial Luxe)</option>
                <option value="emblem">4. Centrat cu Sigiliu (Badge Emblem)</option>
                <option value="brutalist">5. Brutalist / Modernist</option>
                <option value="literary">6. Cărturăresc (Sepia Warm)</option>
                <option value="double">7. Magazin Split (Double Decker)</option>
                <option value="pills">8. Tab-uri Rotunjite (Floating Pills)</option>
                <option value="dramatic">9. Tipografie Dramatică (Giant Hero)</option>
                <option value="typewriter">10. Arhivă Retro (Typewriter)</option>
              </select>
            </div>

            <div>
              <label class="block uppercase font-bold text-stone-700 mb-2">Model Footer</label>
              <select x-model="currentPage.footerType" class="w-full bg-white border border-stone-300 p-2 font-serif rounded focus:outline-none">
                <option value="full">Footer Editorial Complet</option>
                <option value="minimal">Footer Minimalist</option>
              </select>
            </div>
          </div>
          
          
         <!-- TAB 4: Pagini -->
          <div x-show="activeTab === 'pages'" class="p-4 flex flex-col gap-4 text-xs">
            <div class="bg-amber-100/70 p-3 border border-amber-300 rounded text-amber-900 leading-relaxed">
              🗂️ <strong>Panou Control Pagini:</strong><br/>
              Reordonați paginile (ordinea din listă este ordinea din meniul revistei) și gestionați vizibilitatea.
            </div>

            <div class="space-y-2">
              <template x-for="(p, index) in pages" :key="p.slug">
                <div class="p-3 bg-white border border-stone-300 rounded flex items-center justify-between shadow-2xs">
                  <div>
                    <span class="font-bold text-stone-900 block font-serif text-sm flex items-center gap-1.5">
                      <span x-text="p.isPublished === false ? '🔒' : '🔓'" :title="p.isPublished === false ? 'Ascuns (Draft)' : 'Publicat'"></span>
                      <span x-text="p.title"></span>
                    </span>
                    <span class="text-[10px] text-stone-400 font-mono" x-text="'/' + p.slug"></span>
                  </div>

                  <div class="flex items-center gap-1">
                    <!-- Buton Mutare Sus -->
                    <button @click="movePageUp(index)" :disabled="index === 0" class="bg-stone-100 hover:bg-stone-200 disabled:opacity-30 px-1.5 py-1 rounded text-stone-700 font-bold text-[10px]" title="Mută sus în meniu">▲</button>
                    <!-- Buton Mutare Jos -->
