---
import BaseLayout from '../layouts/BaseLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'index' } },
    { params: { slug: 'all' } },
    { params: { slug: 'rest' } }
  ];
}
---
<BaseLayout title="Revistă Săptămânală de Slow Journalism">
  <!-- Bară de Progres la Scroll (Verde Smarald) -->
  <div class="fixed top-0 left-0 w-full h-1.5 bg-transparent z-50 pointer-events-none">
    <div id="scroll-progress-bar" class="h-full bg-emerald-600 w-0 transition-all duration-75 ease-out shadow-sm"></div>
  </div>
  
  <div id="public-site" class="min-h-screen flex flex-col justify-between bg-[#FBF9F5]">
    
    <!-- Header Dinamic -->
    <div id="rendered-header"></div>

    <!-- Conținut Principal -->
    <main class="max-w-5xl mx-auto px-4 py-10 flex-grow w-full" id="rendered-content">
      <section class="text-center py-12">
        <h1 class="font-serif text-2xl text-stone-400">Se încarcă revista din Supabase...</h1>
      </section>
    </main>

    <!-- Footer Dinamic -->
    <div id="rendered-footer"></div>

  </div>

  <!-- Încărcăm clientul Supabase direct în pagină pentru randare dinamică -->
  <script type="module" define:vars={{ supabaseUrl, supabaseAnonKey }}>
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

    // Preluăm variabilele de mediu injectate în siguranță de Astro
    const supabase = createClient(supabaseUrl, supabaseAnonKey);

    document.addEventListener('DOMContentLoaded', async () => {
      // 1. Progres scroll
      const progressBar = document.getElementById('scroll-progress-bar');
      const updateScrollProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (scrollHeight > 0 && progressBar) {
          const progressPercent = (scrollTop / scrollHeight) * 100;
          progressBar.style.width = `${Math.min(100, Math.max(0, progressPercent))}%`;
        }
      };
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();

      // 2. Determinăm slug-ul curent din URL
      const path = window.location.pathname.replace(/^\/|\/$/g, '');
      const currentSlug = path === '' ? 'index' : path;

      try {
        // Preluăm toate paginile din Supabase
        const { data: pages, error: pagesError } = await supabase
          .from('pages')
          .select('*')
          .order('sort_order', { ascending: true });

        if (pagesError || !pages || pages.length === 0) {
          throw new Error('Nu s-au putut încărca paginile din baza de date.');
        }

        // Găsim pagina curentă sau cădem pe index
        const pageData = pages.find(p => p.slug === currentSlug) || pages.find(p => p.slug === 'index');
        const mainPage = pages.find(p => p.slug === 'index');

        if (pageData) {
          const customTitle = pageData.headerTitle || pageData.title || 'IMAGINEA LUMII';
          const metaLeft = pageData.headerMetaLeft || 'Ediția Nr. 42 — Noiembrie 2026';
          const metaCenter = pageData.headerMetaCenter || 'Revistă Săptămânală de Slow Journalism';
          const metaRight = pageData.headerMetaRight || 'Fără zgomot. Doar idei.';
          
          const headerStyle = (mainPage && mainPage.header_type) ? mainPage.header_type : (pageData.header_type || 'classic');
          const footerStyle = (mainPage && mainPage.footer_type) ? mainPage.footer_type : (pageData.footer_type || 'full');
          const customFooter = pageData.footerText || '© 2026 Imaginea Lumii. Toate drepturile rezervate.';
          
          const newsTitle = pageData.newsletterTitle || '📬 Scrisori Editoriale pe Email';
          const newsDesc = pageData.newsletterDesc || 'Primiți analize profunde și eseurile săptămânale direct în inbox. Fără zgomot.';

          const navLinks = pages.map(p => {
            const pUrl = p.slug === 'index' ? '/' : `/${p.slug}`;
            const isActive = p.slug === currentSlug;
            return { url: pUrl, title: p.title, active: isActive };
          });

          const headerContainer = document.getElementById('rendered-header');
          const footerContainer = document.getElementById('rendered-footer');
          let headerHTML = '';
          let footerHTML = '';

          const newsletterHTML = `
            <div class="my-8 p-6 bg-stone-100 border border-stone-300 rounded text-center max-w-xl mx-auto font-sans shadow-xs">
              <h4 class="font-serif font-bold text-base mb-1 tracking-wide text-stone-900">${newsTitle}</h4>
              <p class="text-xs text-stone-600 mb-4">${newsDesc}</p>
              <form onsubmit="event.preventDefault(); alert('Vă mulțumim pentru abonare! Veți primi curând primul număr.'); this.reset();" class="flex gap-2 justify-center">
                <label for="newsletter-email-input" class="sr-only">Adresă de email</label>
                <input id="newsletter-email-input" name="email" type="email" placeholder="adresa.dumneavoastra@email.com" required class="px-3 py-2 text-xs rounded border bg-white border-stone-300 text-stone-900 focus:outline-none focus:border-amber-600 w-64" />
                <button type="submit" class="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 text-xs font-bold uppercase tracking-wider rounded transition">Abonează-te</button>
              </form>
            </div>
          `;

          // Randare Header în funcție de stil
          if (headerStyle === 'classic') {
            const links = navLinks.map(l => `<a href="${l.url}" class="${l.active ? 'text-amber-900 font-bold underline' : 'hover:text-amber-800'}">${l.title}</a>`).join('');
            headerHTML = `<header class="border-b-2 border-stone-900 bg-[#FBF9F5] py-6 text-center font-serif px-4"><div class="max-w-5xl mx-auto flex justify-between items-center text-[11px] text-stone-600 border-b border-stone-300 pb-2 mb-4 font-sans uppercase tracking-widest"><span>${metaLeft}</span><span>${metaCenter}</span><span>${metaRight}</span></div><h1 class="text-5xl font-bold tracking-tight text-stone-900 my-2">${customTitle}</h1><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold tracking-widest text-stone-800 mt-4 border-t border-stone-300 pt-3">${links}<a href="/admin/builder" class="text-amber-800 font-bold">+ Admin</a></nav></header>`;
          } else if (headerStyle === 'minimal') {
            const links = navLinks.map(l => `<a href="${l.url}" class="${l.active ? 'text-stone-900 font-semibold' : 'text-stone-500 hover:text-stone-900'}">${l.title}</a>`).join('');
            headerHTML = `<header class="border-b border-stone-200 bg-white px-8 py-5 flex justify-between items-center font-sans"><a href="/" class="font-serif text-xl font-bold text-stone-900 tracking-tight">${customTitle}</a><nav class="flex items-center gap-6 text-xs font-medium tracking-wide">${links}<a href="/admin/builder" class="bg-stone-900 text-white px-3 py-1.5 rounded-xs text-[11px]">Studio Admin</a></nav></header>`;
          } else {
            const links = navLinks.map(l => `<a href="${l.url}" class="${l.active ? 'text-amber-900 font-bold underline' : 'hover:text-amber-800'}">${l.title}</a>`).join('');
            headerHTML = `<header class="border-b-2 border-stone-900 bg-[#FBF9F5] py-6 text-center font-serif px-4"><h1 class="text-5xl font-bold text-stone-900 my-2">${customTitle}</h1><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold text-stone-800 mt-4">${links}</nav></header>`;
          }

          // Randare Footer
          footerHTML = `<footer class="bg-[#F3EFE6] border-t-2 border-stone-900 text-stone-700 py-10 px-6 font-serif text-center"><div class="max-w-4xl mx-auto">${newsletterHTML}<div class="text-sm font-semibold whitespace-pre-line mt-6">${customFooter}</div><div class="border-t border-stone-300 mt-6 pt-4 text-[11px] flex justify-between items-center font-sans"><span>Toate drepturile rezervate</span><a href="/admin/builder" class="text-amber-900 hover:underline font-bold">Panou Admin</a></div></div></footer>`;

          headerContainer.innerHTML = headerHTML;
          footerContainer.innerHTML = footerHTML;

          // 3. Preluăm blocurile (elementele) asociate acestei pagini din tabela `blocks` din Supabase
          const { data: blocks, error: blocksError } = await supabase
            .from('blocks')
            .select('*')
            .eq('page_id', pageData.id)
            .order('sort_order', { ascending: true });

          const contentContainer = document.getElementById('rendered-content');
          if (contentContainer) {
            contentContainer.setAttribute('class', 'max-w-5xl mx-auto px-4 py-10 flex-grow w-full flex flex-wrap items-start justify-between gap-y-6');

            if (blocks && blocks.length > 0) {
              contentContainer.innerHTML = blocks.map(block => {
                // Extragem HTML-ul și stilul salvate în coloana jsonb `content`
                const blockContent = block.content || {};
                const htmlContent = blockContent.html || '';
                let elementStyle = blockContent.style || 'width: 100%;';
                const isCentered = elementStyle.includes('margin-left: auto') || elementStyle.includes('margin-left:auto');

                if (isCentered) {
                  let calcWidth = '50%';
                  if (elementStyle.includes('width: 30%')) calcWidth = '30%';
                  if (elementStyle.includes('width: 75%')) calcWidth = '75%';

                  return `
                    <div style="width: 100%; display: flex; justify-content: center; box-sizing: border-box;">
                      <div style="width: ${calcWidth}; box-sizing: border-box;">
                        ${htmlContent}
                      </div>
                    </div>
                  `;
                }

                if (elementStyle.includes('width: 50%')) {
                  elementStyle = elementStyle.replace('width: 50%', 'width: calc(50% - 12px)');
                } else if (elementStyle.includes('width: 30%')) {
                  elementStyle = elementStyle.replace('width: 30%', 'width: calc(33.333% - 16px)');
                } else if (elementStyle.includes('width: 75%')) {
                  elementStyle = elementStyle.replace('width: 75%', 'width: calc(75% - 12px)');
                }

                return `
                  <div style="box-sizing: border-box; ${elementStyle}">
                    ${htmlContent}
                  </div>
                `;
              }).join('');
            } else {
              contentContainer.innerHTML = `
                <div class="text-center py-16 font-serif text-stone-500 w-full">
                  Această pagină nu conține încă elemente editoriale în baza de date Supabase.
                </div>
              `;
            }
          }
        }
      } catch (err) {
        console.error("Eroare la preluarea datelor din Supabase:", err);
        document.getElementById('rendered-content').innerHTML = `
          <div class="text-center py-16 font-serif text-red-600 w-full">
            Eroare de conexiune cu baza de date Supabase. Vă rugăm verificați configurarea.
          </div>
        `;
      }
    });
  </script>
</BaseLayout>
