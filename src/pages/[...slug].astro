<script type="module" define:vars={{ supabaseUrl, supabaseAnonKey }}>
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

    const supabase = createClient(supabaseUrl, supabaseAnonKey);

    document.addEventListener('DOMContentLoaded', async () => {
      // 1. Progres scroll
      const progressBar = document.getElementById('scroll-progress-bar');
      const updateScrollProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (scrollHeight > 0 && progressBar) {
          const progressPercent = (scrollTop / scrollHeight) * 100;
          progressBar.style.width = `${Math.min(100, Math.max(0, progressPercent))}%`;
        }
      };
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();

      // 2. Determinăm slug-ul curent din URL
      const path = window.location.pathname.replace(/^\/|\/$/g, '');
      const currentSlug = path === '' ? 'index' : path;

      try {
        const { data: pages, error: pagesError } = await supabase
          .from('pages')
          .select('*')
          .order('sort_order', { ascending: true });

        if (pagesError || !pages || pages.length === 0) {
          throw new Error('Nu s-au putut încărca paginile din baza de date.');
        }

        const pageData = pages.find(p => p.slug === currentSlug) || pages.find(p => p.slug === 'index');
        const mainPage = pages.find(p => p.slug === 'index');

        if (pageData) {
          const customTitle = pageData.headerTitle || pageData.title || 'IMAGINEA LUMII';
          const metaLeft = pageData.headerMetaLeft || 'Ediția Nr. 42 — Noiembrie 2026';
          const metaCenter = pageData.headerMetaCenter || 'Revistă Săptămânală de Slow Journalism';
          const metaRight = pageData.headerMetaRight || 'Fără zgomot. Doar idei.';
          
          // FORȚĂM CA TOATE PAGINILE SĂ PREIAU STILUL DE HEADER DIN PAGINA INDEX
          const headerStyle = (mainPage && mainPage.header_type) ? mainPage.header_type : 'classic';
          const footerStyle = (mainPage && mainPage.footer_type) ? mainPage.footer_type : (pageData.footer_type || 'full');
          const customFooter = pageData.footerText || '© 2026 Imaginea Lumii. Toate drepturile rezervate.';
          
          const newsTitle = pageData.newsletterTitle || '📬 Scrisori Editoriale pe Email';
          const newsDesc = pageData.newsletterDesc || 'Primiți analize profunde și eseurile săptămânale direct în inbox. Fără zgomot.';

          // Generăm linkurile cu indicatorul de pagină activă (subliniat / evidențiat)
          const navLinks = pages.map(p => {
            const pUrl = p.slug === 'index' ? '/' : `/${p.slug}`;
            const isActive = p.slug === currentSlug;
            return { url: pUrl, title: p.title, active: isActive };
          });

          const headerContainer = document.getElementById('rendered-header');
          const footerContainer = document.getElementById('rendered-footer');
          let headerHTML = '';
          let footerHTML = '';

          const newsletterHTML = `
            <div class="my-8 p-6 bg-stone-100 border border-stone-300 rounded text-center max-w-xl mx-auto font-sans shadow-xs">
              <h4 class="font-serif font-bold text-base mb-1 tracking-wide text-stone-900">${newsTitle}</h4>
              <p class="text-xs text-stone-600 mb-4">${newsDesc}</p>
              <form onsubmit="event.preventDefault(); alert('Vă mulțumim pentru abonare! Veți primi curând primul număr.'); this.reset();" class="flex gap-2 justify-center">
                <label for="newsletter-email-input" class="sr-only">Adresă de email</label>
                <input id="newsletter-email-input" name="email" type="email" placeholder="adresa.dumneavoastra@email.com" required class="px-3 py-2 text-xs rounded border bg-white border-stone-300 text-stone-900 focus:outline-none focus:border-amber-600 w-64" />
                <button type="submit" class="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 text-xs font-bold uppercase tracking-wider rounded transition">Abonează-te</button>
              </form>
            </div>
          `;

          // Funcție helper pentru randarea linkurilor cu stil activ
          const renderLinks = (activeClass = 'text-amber-900 font-bold underline', inactiveClass = 'hover:text-amber-800 text-stone-700') => {
            return navLinks.map(l => `<a href="${l.url}" class="${l.active ? activeClass : inactiveClass}">${l.title}</a>`).join('');
          };

          // RANDARE HEADER PENTRU TOATE CELE 10 MODELE
          switch (headerStyle) {
            case 'classic': // 1. Clasic Gazetă
              headerHTML = `<header class="border-b-2 border-stone-900 bg-[#FBF9F5] py-6 text-center font-serif px-4"><div class="max-w-5xl mx-auto flex justify-between items-center text-[11px] text-stone-600 border-b border-stone-300 pb-2 mb-4 font-sans uppercase tracking-widest"><span>${metaLeft}</span><span>${metaCenter}</span><span>${metaRight}</span></div><h1 class="text-5xl font-bold tracking-tight text-stone-900 my-2">${customTitle}</h1><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold tracking-widest text-stone-800 mt-4 border-t border-stone-300 pt-3">${renderLinks()}</nav></header>`;
              break;
            case 'minimal': // 2. Minimalist Modern
              headerHTML = `<header class="border-b border-stone-200 bg-white px-8 py-5 flex justify-between items-center font-sans"><a href="/" class="font-serif text-xl font-bold text-stone-900 tracking-tight">${customTitle}</a><nav class="flex items-center gap-6 text-xs font-medium tracking-wide">${renderLinks('text-stone-900 font-bold border-b border-stone-900 pb-0.5', 'text-stone-500 hover:text-stone-900')}</nav></header>`;
              break;
            case 'luxe': // 3. Revistă de Artă (Editorial Luxe)
              headerHTML = `<header class="bg-stone-900 text-stone-100 py-8 text-center font-serif px-4 border-b border-amber-700"><span class="text-[10px] tracking-[0.3em] uppercase text-amber-500 block mb-2">${metaCenter}</span><h1 class="text-4xl md:text-6xl font-normal tracking-wide my-2">${customTitle}</h1><nav class="flex justify-center gap-10 text-xs uppercase font-sans tracking-widest text-stone-300 mt-6">${renderLinks('text-amber-400 font-bold tracking-widest underline', 'hover:text-amber-400 text-stone-400')}</nav></header>`;
              break;
            case 'emblem': // 4. Centrat cu Sigiliu
              headerHTML = `<header class="border-b border-stone-300 bg-[#F9F8F6] py-8 text-center font-serif px-4"><div class="w-12 h-12 mx-auto mb-3 rounded-full bg-stone-900 text-white flex items-center justify-center font-bold text-sm tracking-tighter">IL</div><h1 class="text-4xl font-bold text-stone-900 tracking-tight">${customTitle}</h1><p class="text-xs text-stone-500 font-sans mt-1 uppercase tracking-widest">${metaCenter}</p><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold tracking-wider text-stone-800 mt-5">${renderLinks()}</nav></header>`;
              break;
            case 'brutalist': // 5. Brutalist / Modernist
              headerHTML = `<header class="border-b-4 border-black bg-yellow-300 py-6 px-6 flex flex-col md:flex-row justify-between items-center font-mono"><h1 class="text-3xl font-black uppercase tracking-tighter text-black">${customTitle}</h1><nav class="flex gap-4 text-xs font-bold uppercase mt-4 md:mt-0">${renderLinks('bg-black text-white px-2 py-1', 'bg-white border border-black text-black px-2 py-1 hover:bg-black hover:text-white')}</nav></header>`;
              break;
            case 'literary': // 6. Cărturăresc (Sepia Warm)
              headerHTML = `<header class="border-b border-amber-900/20 bg-[#F4EFEB] py-8 text-center font-serif px-4"><h1 class="text-4xl italic font-normal text-amber-950">${customTitle}</h1><div class="w-24 h-px bg-amber-900/30 mx-auto my-3"></div><nav class="flex justify-center gap-6 text-xs uppercase font-sans tracking-widest text-amber-900">${renderLinks('font-bold text-amber-955 underline', 'hover:text-amber-950 text-amber-800/80')}</nav></header>`;
              break;
            case 'double': // 7. Magazin Split (Double Decker)
              headerHTML = `<header class="border-b border-stone-300 bg-white font-sans text-xs"><div class="bg-stone-900 text-stone-200 py-1.5 px-6 flex justify-between"><span>${metaLeft}</span><span>${metaRight}</span></div><div class="py-5 px-6 flex justify-between items-center border-b border-stone-200"><h1 class="font-serif text-3xl font-bold text-stone-900">${customTitle}</h1><span class="text-stone-500 italic">${metaCenter}</span></div><nav class="flex justify-start gap-8 px-6 py-2.5 uppercase font-semibold text-stone-700">${renderLinks('text-amber-800 font-bold border-b-2 border-amber-800 pb-1', 'hover:text-stone-900')}</nav></header>`;
              break;
            case 'pills': // 8. Tab-uri Rotunjite (Floating Pills)
              headerHTML = `<header class="bg-[#F8F6F0] py-8 text-center font-serif px-4 border-b border-stone-200"><h1 class="text-4xl font-bold text-stone-900 mb-4">${customTitle}</h1><nav class="inline-flex bg-stone-200 p-1.5 rounded-full gap-2 text-xs font-sans uppercase font-medium">${renderLinks('bg-white text-stone-900 px-4 py-1.5 rounded-full shadow-xs font-bold', 'text-stone-600 hover:text-stone-900 px-4 py-1.5')}</nav></header>`;
              break;
            case 'dramatic': // 9. Tipografie Dramatică (Giant Hero)
              headerHTML = `<header class="border-b-2 border-stone-900 bg-stone-900 text-white py-12 text-center font-serif px-4"><h1 class="text-6xl md:text-7xl font-black tracking-tighter uppercase my-2">${customTitle}</h1><p class="text-xs uppercase font-sans tracking-[0.4em] text-amber-400 mt-2">${metaCenter}</p><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold tracking-widest text-stone-300 mt-6">${renderLinks('text-white font-bold underline', 'text-stone-400 hover:text-white')}</nav></header>`;
              break;
            case 'typewriter': // 10. Arhivă Retro (Typewriter)
              headerHTML = `<header class="border-b-2 border-dashed border-stone-400 bg-[#F4F1EA] py-6 text-center font-mono px-4"><span class="text-[10px] uppercase text-stone-500 tracking-widest">[ ${metaLeft} ]</span><h1 class="text-4xl font-bold text-stone-900 my-2">${customTitle}</h1><nav class="flex justify-center gap-6 text-xs uppercase font-mono mt-3">${renderLinks('bg-stone-900 text-white px-2 py-1 font-bold', 'text-stone-700 hover:bg-stone-300 px-2 py-1')}</nav></header>`;
              break;
            default: // Fallback de siguranță
              headerHTML = `<header class="border-b-2 border-stone-900 bg-[#FBF9F5] py-6 text-center font-serif px-4"><h1 class="text-5xl font-bold text-stone-900 my-2">${customTitle}</h1><nav class="flex justify-center gap-8 text-xs uppercase font-sans font-semibold text-stone-800 mt-4">${renderLinks()}</nav></header>`;
              break;
          }

          // Randare Footer
          footerHTML = `<footer class="bg-[#F3EFE6] border-t-2 border-stone-900 text-stone-700 py-10 px-6 font-serif text-center"><div class="max-w-4xl mx-auto">${newsletterHTML}<div class="text-sm font-semibold whitespace-pre-line mt-6">${customFooter}</div><div class="border-t border-stone-300 mt-6 pt-4 text-[11px] flex justify-between items-center font-sans"><span>Toate drepturile rezervate</span></div></div></footer>`;

          headerContainer.innerHTML = headerHTML;
          footerContainer.innerHTML = footerHTML;

          // 3. Preluăm blocurile asociate paginii curente din Supabase
          const { data: blocks, error: blocksError } = await supabase
            .from('blocks')
            .select('*')
            .eq('page_id', pageData.id)
            .order('sort_order', { ascending: true });

          const contentContainer = document.getElementById('rendered-content');
          if (contentContainer) {
            contentContainer.setAttribute('class', 'max-w-5xl mx-auto px-4 py-10 flex-grow w-full flex flex-wrap items-start justify-between gap-y-6');

            if (blocks && blocks.length > 0) {
              contentContainer.innerHTML = blocks.map(block => {
                const blockContent = block.content || {};
                const htmlContent = blockContent.html || '';
                let elementStyle = blockContent.style || 'width: 100%;';
                const isCentered = elementStyle.includes('margin-left: auto') || elementStyle.includes('margin-left:auto');

                if (isCentered) {
                  let calcWidth = '50%';
                  if (elementStyle.includes('width: 30%')) calcWidth = '30%';
                  if (elementStyle.includes('width: 75%')) calcWidth = '75%';

                  return `
                    <div style="width: 100%; display: flex; justify-content: center; box-sizing: border-box;">
                      <div style="width: ${calcWidth}; box-sizing: border-box;">
                        ${htmlContent}
                      </div>
                    </div>
                  `;
                }

                if (elementStyle.includes('width: 50%')) {
                  elementStyle = elementStyle.replace('width: 50%', 'width: calc(50% - 12px)');
                } else if (elementStyle.includes('width: 30%')) {
                  elementStyle = elementStyle.replace('width: 30%', 'width: calc(33.333% - 16px)');
                } else if (elementStyle.includes('width: 75%')) {
                  elementStyle = elementStyle.replace('width: 75%', 'width: calc(75% - 12px)');
                }

                return `
                  <div style="box-sizing: border-box; ${elementStyle}">
                    ${htmlContent}
                  </div>
                `;
              }).join('');
            } else {
              contentContainer.innerHTML = `
                <div class="text-center py-16 font-serif text-stone-500 w-full">
                  Această pagină nu conține încă elemente editoriale în baza de date Supabase.
                </div>
              `;
            }
          }
        }
      } catch (err) {
        console.error("Eroare la preluarea datelor din Supabase:", err);
        document.getElementById('rendered-content').innerHTML = `
          <div class="text-center py-16 font-serif text-red-600 w-full">
            Eroare de conexiune cu baza de date Supabase. Vă rugăm verificați configurarea.
          </div>
        `;
      }
    });
  </script>
